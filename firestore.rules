rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'creatorFormat', 'niche', 'platform', 'pacingDensity', 'brandTone'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'creatorFormat', 'niche', 'microTags', 'platform', 'pacingDensity', 'brandTone', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.creatorFormat is string && data.creatorFormat.size() <= 100
        && data.niche is string && data.niche.size() <= 100
        && data.platform is string && data.platform.size() <= 100
        && data.pacingDensity is string && data.pacingDensity.size() <= 100
        && data.brandTone is string && data.brandTone.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('microTags' in data) || (data.microTags is list && data.microTags.size() <= 25))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'aspectRatio'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 120
        && data.aspectRatio is string && data.aspectRatio.size() <= 10
        && (!('scriptText' in data) || (data.scriptText is string && data.scriptText.size() <= 30000))
        && (!('brollItems' in data) || (data.brollItems is list && data.brollItems.size() <= 100))
        && (!('captionItems' in data) || (data.captionItems is list && data.captionItems.size() <= 200))
        && (!('sfxItems' in data) || (data.sfxItems is list && data.sfxItems.size() <= 100))
        && (!('subtitleStyle' in data) || (data.subtitleStyle is map))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500));
    }

    // Test collection for connection check
    match /test/{docId} {
      allow read: if true;
    }

    // Creator user profile collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Deny broad list queries to prevent user enumeration
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == resource.data.uid;
      allow delete: if isOwner(userId);

      // User projects subcollection in Firestore
      match /projects/{projectId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming());
        allow update: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming())
          && incoming().userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
